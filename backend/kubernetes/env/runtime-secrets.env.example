# Dotenv-style file (KEY=value). Copy to runtime-secrets.env in this directory (gitignored).
#
#   cp env/runtime-secrets.env.example env/runtime-secrets.env
#
# Optional: use a classic .env name instead — pass it to the script:
#   cp env/runtime-secrets.env.example .env.runtime-secrets
#   ./backend/kubernetes/job-apply-runtime-secret-from-env.sh backend/kubernetes/env/.env.runtime-secrets
#
# Apply Secret studyjam-k8s-runtime (namespace studyjam-k8s):
#   ./backend/kubernetes/job-apply-runtime-secret-from-env.sh
#   # or: kubectl apply -k backend/kubernetes/secret-from-env
#
DB_PASSWORD=REPLACE_WITH_CLOUD_SQL_PASSWORD
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
